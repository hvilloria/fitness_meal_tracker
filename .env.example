# Copy to .env and adjust. .env is gitignored.

# Local Postgres container (compose.yaml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Production only (compose.prod.yaml). Use the Supabase Supavisor pooler on
# port 5432 (session mode), not 6543 (transaction mode).
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=hosward.avc@gmail.com
