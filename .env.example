# Copy to .env and adjust. .env is gitignored.

# Local Postgres container (compose.yaml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Production only (compose.prod.yaml / Render). Neon serverless Postgres,
# single database — see config/database.yml.
# DATABASE_URL=postgres://<user>:<password>@<project>.<region>.aws.neon.tech/<dbname>?sslmode=require

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=you@example.com
