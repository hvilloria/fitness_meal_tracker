<% content_for :title, "Progreso" %>

<%# The week is the unit of outcome, so it leads with a budget: the sum of
    each logged day's OWN goal against what was actually eaten. Unlogged
    days sit out of both sides of the sum — see ProgressSummary — and the
    screen says so plainly rather than burying it as a footnote. %>
<section class="card stack" aria-label="Semana">
  <h2>Semana</h2>

  <% if @summary.week_empty? %>
    <p class="empty">Todavía no registraste ningún día esta semana.</p>
  <% else %>
    <p class="between tnum">
      <span>Semana</span>
      <span>
        <%= number_with_precision(@summary.week_consumed, precision: 0, delimiter: ".") %>
        / <%= number_with_precision(@summary.week_budget, precision: 0, delimiter: ".") %> kcal
      </span>
    </p>
    <p class="tnum">
      <span class="<%= class_names("negative" => @summary.week_remaining.negative?) %>">
        Te quedan <%= number_with_precision(@summary.week_remaining, precision: 0, delimiter: ".") %>
      </span>
      para <%= @summary.week_upcoming_label %>
    </p>
    <p class="muted field__hint">
      Sobre <%= @summary.week_logged_count %> de <%= @summary.week_total_days %> días registrados.
    </p>

    <div class="weekbars" role="img" aria-label="Calorías por día de la semana">
      <% @summary.week_days.each_with_index do |day, index| %>
        <%= render "week_day_bar", day: day, label: ProgressSummary::DAY_ABBREVIATIONS[index] %>
      <% end %>
    </div>
  <% end %>
</section>

<%# A monthly balance isn't actionable — knowing you're 8.000 kcal over
    doesn't tell you what to eat today — so the month reports averages
    instead of a running total, again over logged days only. %>
<section class="card stack" aria-label="Mes">
  <h2>Mes</h2>

  <% if @summary.month_empty? %>
    <p class="empty">Todavía no registraste ningún día este mes.</p>
  <% else %>
    <div class="between tnum">
      <span>Promedio diario</span>
      <span>
        <%= number_with_precision(@summary.month_average_kcal, precision: 0, delimiter: ".") %> kcal
        <span class="muted">· meta <%= number_with_precision(@summary.month_average_goal_kcal, precision: 0, delimiter: ".") %></span>
      </span>
    </div>
    <div class="between tnum">
      <span>Proteína</span>
      <span>
        <%= number_with_precision(@summary.month_average_protein_g, precision: 0) %> g
        <span class="muted">· meta <%= number_with_precision(@summary.month_average_goal_protein_g, precision: 0) %></span>
      </span>
    </div>
    <div class="between tnum">
      <span>Días registrados</span>
      <span><%= @summary.month_logged_count %> de <%= @summary.month_elapsed_days %></span>
    </div>
    <div class="between tnum">
      <span>Días en meta</span>
      <span><%= @summary.month_on_target_count %></span>
    </div>
    <p class="muted field__hint">
      "En meta" es un día dentro del ±<%= (ProgressSummary::ON_TARGET_TOLERANCE * 100).to_i %>% de la meta de ese día.
    </p>
  <% end %>
</section>
