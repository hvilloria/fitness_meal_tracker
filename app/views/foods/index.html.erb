<% content_for :title, "Alimentos" %>

<div class="section__head">
  <h1>Alimentos</h1>
  <%= link_to "Nuevo", new_food_path, class: "button button--primary" %>
</div>

<div class="stack">
  <% if @foods.empty? %>
    <p class="empty">Todavía no cargaste ningún alimento.</p>
  <% end %>
  <%= render @foods %>
</div>
