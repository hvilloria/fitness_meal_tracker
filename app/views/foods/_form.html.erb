<%= form_with model: food, class: "stack",
      data: { controller: "macro-calculator", action: "input->macro-calculator#recalculate" } do |form| %>
  <% if food.errors.any? %>
    <div class="flash flash--alert">
      <%= food.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name, "Nombre" %>
    <%= form.text_field :name %>
  </div>

  <div class="field">
    <%= form.label :brand, "Marca (opcional)" %>
    <%= form.text_field :brand %>
  </div>

  <div class="field">
    <%= form.label :state, "Estado" %>
    <%= form.select :state, Food::STATES.map { |state| [ t("food.states.#{state}"), state ] }, include_blank: "No aplica" %>
  </div>

  <div class="field">
    <%= form.label :unit, "Unidad" %>
    <%= form.select :unit, Food::UNITS.map { |unit| [ t("food.units.#{unit}"), unit ] } %>
  </div>

  <p class="muted">Valores de la etiqueta, <%= food.per_100_label %>.</p>

  <div class="field">
    <%= form.label :kcal_per_100, "Calorías (opcional)" %>
    <%= form.number_field :kcal_per_100, step: :any, inputmode: "decimal" %>
    <p class="field__hint">
      Si se deja en blanco, se calcula a partir de las macros
      (<span data-macro-calculator-target="kcal">0</span> kcal).
    </p>
  </div>

  <div class="field">
    <%= form.label :protein_per_100, "Proteína (g)" %>
    <%= form.number_field :protein_per_100, step: :any, inputmode: "decimal",
          data: { macro_calculator_target: "protein" } %>
  </div>

  <div class="field">
    <%= form.label :carbs_per_100, "Carbohidratos (g)" %>
    <%= form.number_field :carbs_per_100, step: :any, inputmode: "decimal",
          data: { macro_calculator_target: "carbs" } %>
  </div>

  <div class="field">
    <%= form.label :fat_per_100, "Grasa (g)" %>
    <%= form.number_field :fat_per_100, step: :any, inputmode: "decimal",
          data: { macro_calculator_target: "fat" } %>
  </div>

  <h2>Porciones</h2>
  <p class="muted">Por ejemplo "1 feta" equivale a 30 g.</p>

  <div class="stack" data-controller="nested-fields">
    <div class="stack" data-nested-fields-target="list">
      <%# include_id: false because each row renders its own hidden id (see
          _serving_fields): fields_for would append it after the row instead
          of inside it, and the remove button needs it within the row. %>
      <%= form.fields_for :servings, include_id: false do |serving_form| %>
        <%= render "serving_fields", form: serving_form %>
      <% end %>
    </div>

    <%# The blank row to clone. Its index is a placeholder the Stimulus
        controller swaps for a unique one, so two rows added in a row do not
        collide under the same servings_attributes key. %>
    <template data-nested-fields-target="template">
      <%= form.fields_for :servings, Serving.new, child_index: "NEW_RECORD", include_id: false do |serving_form| %>
        <%= render "serving_fields", form: serving_form %>
      <% end %>
    </template>

    <button type="button" class="button button--quiet" data-action="nested-fields#add">
      Agregar porción
    </button>
  </div>

  <%= form.submit "Guardar", class: "button button--primary" %>
<% end %>
