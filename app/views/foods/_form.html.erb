<%= form_with model: food, class: "stack",
      data: { controller: "macro-calculator", action: "input->macro-calculator#recalculate" } do |form| %>
  <% if food.errors.any? %>
    <div class="flash flash--alert">
      <%= food.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name, "Nombre" %>
    <%= form.text_field :name %>
  </div>

  <div class="field">
    <%= form.label :brand, "Marca (opcional)" %>
    <%= form.text_field :brand %>
  </div>

  <div class="field">
    <%= form.label :state, "Estado" %>
    <%= form.select :state, Food::STATES.map { |state| [ t("food.states.#{state}"), state ] }, include_blank: "No aplica" %>
  </div>

  <div class="field">
    <%= form.label :unit, "Unidad" %>
    <%= form.select :unit, Food::UNITS.map { |unit| [ t("food.units.#{unit}"), unit ] } %>
  </div>

  <%# The basis of everything typed below: one portion of this food, stated
      in the food's own unit. A label that already reads per 100 needs no
      thought — 100 is the default. The input sits inside its own label so
      the whole sentence names it, rather than a bare number field next to
      loose text.

      A text field, not a number field: this is where the unit gets typed
      along with the number ("30 g"), and a number input answers that by
      handing the server an empty string — the typed value disappears with
      nothing to report. As text it arrives intact and
      NormalizesDecimalParams takes the number out of it. %>
  <div class="field">
    <%= form.label :portion_amount, class: "portion" do %>
      Los valores son por cada
      <%= form.text_field :portion_amount, inputmode: "decimal",
            value: food_decimal_field_value(food.portion_amount) %>
      <%= food.unit_abbreviation %>
    <% end %>
  </div>

  <div class="field">
    <%= form.label :kcal_per_portion, "Calorías (opcional)" %>
    <%= form.number_field :kcal_per_portion, step: :any, inputmode: "decimal",
          value: food_decimal_field_value(food.kcal_per_portion) %>
    <p class="field__hint">
      Si se deja en blanco, se calcula a partir de las macros
      (<span data-macro-calculator-target="kcal">0</span> kcal por porción).
    </p>
  </div>

  <div class="field">
    <%= form.label :protein_per_portion, "Proteína (g)" %>
    <%= form.number_field :protein_per_portion, step: :any, inputmode: "decimal",
          value: food_decimal_field_value(food.protein_per_portion),
          data: { macro_calculator_target: "protein" } %>
  </div>

  <div class="field">
    <%= form.label :carbs_per_portion, "Carbohidratos (g)" %>
    <%= form.number_field :carbs_per_portion, step: :any, inputmode: "decimal",
          value: food_decimal_field_value(food.carbs_per_portion),
          data: { macro_calculator_target: "carbs" } %>
  </div>

  <div class="field">
    <%= form.label :fat_per_portion, "Grasa (g)" %>
    <%= form.number_field :fat_per_portion, step: :any, inputmode: "decimal",
          value: food_decimal_field_value(food.fat_per_portion),
          data: { macro_calculator_target: "fat" } %>
  </div>

  <%= form.submit "Guardar", class: "button button--primary" %>
<% end %>
