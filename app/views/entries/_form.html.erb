<%= form_with model: entry, url: entries_path, class: "stack",
      data: { controller: "entry-preview", action: "input->entry-preview#preview change->entry-preview#preview" } do |form| %>

  <% if entry.errors.any? %>
    <div class="flash flash--alert"><%= entry.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="field">
    <%= form.label :meal, "Comida" %>
    <%= form.select :meal, Entry::MEALS.map { |meal| [ t("meals.#{meal}"), meal ] } %>
  </div>

  <div class="field">
    <%= form.label :food_id, "Alimento" %>
    <%= form.select :food_id,
          food_select_groups(recent_foods, other_foods, last_grams),
          { include_blank: "Elegí un alimento" },
          data: { entry_preview_target: "food", action: "change->entry-preview#foodChanged" } %>
  </div>

  <%# The amount is a quantity plus the unit it is counted in. The units on
      offer belong to the selected food (its own g/ml, that unit ×1000, and
      each of its servings), so the list is rebuilt in the browser whenever
      the food changes — see entry_preview_controller.js#foodChanged. %>
  <div class="amount">
    <div class="field">
      <%= form.label :quantity, "Cantidad" %>
      <%= form.number_field :quantity, step: :any, inputmode: "decimal",
            data: { entry_preview_target: "quantity" } %>
    </div>

    <div class="field">
      <%= form.label :unit, "Unidad" %>
      <%= form.select :unit, entry_unit_options(entry.food), {},
            data: { entry_preview_target: "unit" } %>
    </div>
  </div>

  <div class="card preview">
    <p class="preview__value tnum">
      <span data-entry-preview-target="kcal">0</span> kcal
    </p>
    <ul class="chips">
      <li class="chip chip--protein"><span class="chip__key">P</span><span data-entry-preview-target="protein">0</span></li>
      <li class="chip chip--carbs"><span class="chip__key">C</span><span data-entry-preview-target="carbs">0</span></li>
      <li class="chip chip--fat"><span class="chip__key">G</span><span data-entry-preview-target="fat">0</span></li>
    </ul>
  </div>

  <%= form.submit "Agregar", class: "button button--primary" %>
<% end %>

<p><%= link_to "Cargar algo que no está en el catálogo", new_entry_path(ad_hoc: true) %></p>
